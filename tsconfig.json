{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2017",
    "lib": ["DOM", "ES2020"],
    "noImplicitAny": true,
    "preserveConstEnums": true,
    "outDir": "./dist",
    "sourceMap": true,
    "noEmitHelpers": true,
    "importHelpers": true,
    "experimentalDecorators": true,
    "strict": true,
    "declaration": true,
    "removeComments": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "**/*.test.ts"]
}
